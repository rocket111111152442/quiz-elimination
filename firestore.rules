rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Seul l'hôte peut faire avancer la partie (questions, statut...).
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;

        // Un joueur ne peut créer que sa propre fiche.
        allow create: if request.auth != null && request.auth.uid == playerId;

        allow update: if request.auth != null && (
          // Un joueur ne peut modifier que ses propres réponses...
          (request.auth.uid == playerId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers']))
          ||
          // ...l'hôte seul peut changer alive / eliminatedAtQuestion (élimination).
          (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid)
        );

        allow delete: if false;
      }
    }
  }
}
