rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Progression persistante par appareil (points de boutique, avatar et
    // couleur débloqués) — indexée sur l'uid anonyme stable de l'appareil.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        // Le propriétaire peut tout changer (débloquer un objet, choisir
        // son avatar/sa couleur).
        request.auth.uid == uid
        ||
        // ...n'importe quel autre appareil peut créditer des points en
        // fin de partie (c'est parfois l'hôte, parfois un autre joueur
        // selon le jeu) — mais uniquement en ajouter, rien d'autre.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
         && request.resource.data.points > resource.data.points)
      );
      allow delete: if false;
    }

    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Seul l'hôte peut faire avancer le quiz. Pour l'Undercover, le
      // Loup-Garou et l'UNO, la partie avance à travers l'appareil de
      // chaque joueur à son tour (nuits, votes, tours de jeu, mais aussi
      // le bouton "Quitter la partie" qui doit pouvoir retirer un joueur
      // du tour de jeu depuis son propre appareil) plutôt que par un
      // hôte-spectateur qui cliquerait à la place des autres — n'importe
      // quel joueur de la salle peut donc faire avancer ces trois jeux,
      // exactement comme il peut déjà tout lire dans la salle.
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid
        || ((resource.data.gameType == 'werewolf' ||
             resource.data.gameType == 'uno' ||
             resource.data.gameType == 'undercover') &&
            exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid)))
      );

      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;

        // Un joueur ne peut créer que sa propre fiche.
        allow create: if request.auth != null && request.auth.uid == playerId;

        allow update: if request.auth != null && (
          // Un joueur ne peut modifier que ses propres réponses (quiz)...
          (request.auth.uid == playerId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers']))
          ||
          // ...l'hôte seul peut changer alive / eliminatedAtQuestion (élimination, quiz/Undercover)...
          (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid)
          ||
          // ...n'importe quel joueur peut à tout moment s'auto-éliminer
          // (bouton "Quitter la partie"), même dans les jeux où seul
          // l'hôte contrôle l'élimination normalement — jamais l'inverse
          // (se ressusciter soi-même).
          (request.auth.uid == playerId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alive', 'eliminatedAtQuestion']) &&
           request.resource.data.alive == false)
          ||
          // ...au Loup-Garou et à l'UNO, n'importe quel joueur de la salle
          // peut éliminer n'importe quel autre joueur (résolution d'une
          // nuit/d'un vote/d'une vengeance de Chasseur, ou élimination
          // pour inactivité, se fait sur l'appareil de celui qui
          // déclenche la résolution).
          ((get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'werewolf' ||
            get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'uno') &&
           exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alive', 'eliminatedAtQuestion']))
        );

        allow delete: if false;
      }

      // Undercover : mot secret + rôle de chaque joueur, invisible des
      // autres joueurs tant que la partie n'est pas terminée.
      // Loup-Garou : carte de chaque joueur, invisible sauf pour la
      // Voyante (qui peut regarder n'importe quelle carte pendant la
      // partie — l'appli ne lui montre qu'une seule à la fois, une par
      // nuit).
      // UNO : main de cartes de chaque joueur, jamais visible des autres.
      match /secrets/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'finished'
          || (
               get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'werewolf'
               && get(/databases/$(database)/documents/rooms/$(roomCode)/secrets/$(request.auth.uid)).data.role == 'voyante'
             )
          // Les Loups-Garous se reconnaissent entre eux (comme autour
          // d'une vraie table) : un loup peut lire la carte d'un autre
          // joueur uniquement si elle est aussi 'loupGarou'.
          || (
               get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'werewolf'
               && resource.data.role == 'loupGarou'
               && get(/databases/$(database)/documents/rooms/$(roomCode)/secrets/$(request.auth.uid)).data.role == 'loupGarou'
             )
        );

        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          // UNO : celui qui pioche pour lui-même, ou qui fait piocher un
          // autre joueur suite à un +2/+4/pénalité "UNO !" oublié, écrit
          // directement dans la main visée depuis son propre appareil.
          || (
               get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'uno'
               && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid))
             )
        );
      }

      // Undercover : les deux mots de la manche (civil / undercover).
      match /meta/{docId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'finished'
        );

        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
      }

      // Indices/votes d'Undercover et actions de nuit/vote du Loup-Garou :
      // chaque joueur n'écrit que sa propre entrée, mais tout le monde
      // peut tout lire (indices visibles de tous, comme en vrai autour de
      // la table ; pour le Loup-Garou l'appli ne montre chaque action
      // qu'au joueur concerné, même si la règle est large).
      match /rounds/{roundIndex} {
        match /clues/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }

        match /votes/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }

        // Undercover : la devinette de Mister White (un seul joueur écrit,
        // celui qui vient d'être démasqué).
        match /guesses/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }

        // Loup-Garou : votes des loups, protection du Salvateur, regard de
        // la Voyante, action de la Sorcière, choix de Cupidon, vote du
        // village — chacun peut réécrire sa propre entrée (pour changer
        // d'avis avant que le tour ne soit résolu).
        match /wolfVotes/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /salvateurChoice/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /voyanteLooks/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /witchActions/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /cupidonChoice/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
        match /dayVotes/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
