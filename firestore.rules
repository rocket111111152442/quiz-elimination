rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Seul l'hôte peut faire avancer la partie (questions, statut, tours...).
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;

        // Un joueur ne peut créer que sa propre fiche.
        allow create: if request.auth != null && request.auth.uid == playerId;

        allow update: if request.auth != null && (
          // Un joueur ne peut modifier que ses propres réponses (quiz)...
          (request.auth.uid == playerId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers']))
          ||
          // ...ou, dans la course de motos, son propre choix de moto et sa
          // progression (tours, arrivée)...
          (request.auth.uid == playerId &&
           get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameType == 'racing' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bike', 'lapsCompleted', 'finished', 'finishTimeMs']))
          ||
          // ...l'hôte seul peut changer alive / eliminatedAtQuestion (élimination).
          (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid)
        );

        allow delete: if false;
      }

      // Undercover : mot secret + rôle de chaque joueur, invisible des
      // autres joueurs tant que la partie n'est pas terminée.
      match /secrets/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'finished'
        );

        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
      }

      // Undercover : les deux mots de la manche (civil / undercover).
      match /meta/{docId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'finished'
        );

        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
      }

      // Undercover : indices et votes d'une manche, chaque joueur n'écrit
      // que sa propre entrée mais tout le monde peut tout lire (indices
      // visibles de tous, comme en vrai autour de la table).
      match /rounds/{roundIndex} {
        match /clues/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }

        match /votes/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }

        // Undercover : la devinette de Mister White (un seul joueur écrit,
        // celui qui vient d'être démasqué).
        match /guesses/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if false;
        }
      }

      // Course de motos : position en temps réel de chaque joueur, écrite
      // très fréquemment par son propriétaire uniquement.
      match /positions/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
